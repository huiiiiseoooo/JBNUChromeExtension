{
  "manifest_version": 3,
  "name": "전북대 공지 키워드 알림 (비공식)",
  "short_name": "JBNU 알림",
  "version": "1.0.0",
  "description": "전북대·학과 공지에서 키워드를 찾아 새 탭에 모아 보여주는 비공식 확장. 오늘의 학식, 주요 뉴스, 바로가기도 함께.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "전북대 공지 키워드 알림 (비공식)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "options_page": "options/index.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "search"
  ],
  "host_permissions": [
    "https://*.jbnu.ac.kr/*",
    "https://suggestqueries.google.com/*"
  ]
}
